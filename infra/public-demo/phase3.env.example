# Dedicated Phase 3 public-demo profile. Deploy separately from every private environment.
CV_ENVIRONMENT=production
CV_OBJECT_STORE_BACKEND=oss
CV_OBJECT_STORE_CREDENTIAL_MODE=oidc_role_arn
CV_OBJECT_STORE_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
CV_OBJECT_STORE_PRESIGN_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
CV_OBJECT_STORE_REGION=cn-hangzhou
CV_OBJECT_STORE_OIDC_ROLE_ARN=acs:ram::1234567890123456:role/commercevision-public-demo
CV_OBJECT_STORE_OIDC_PROVIDER_ARN=acs:ram::1234567890123456:oidc-provider/commercevision-public-demo
CV_OBJECT_STORE_OIDC_TOKEN_FILE_PATH=/var/run/secrets/public-demo-oss-oidc-token
CV_OBJECT_STORE_STS_ENDPOINT=sts-vpc.cn-hangzhou.aliyuncs.com
CV_OBJECT_STORE_ROLE_SESSION_NAME=commercevision-public-demo
CV_OBJECT_STORE_QUARANTINE_BUCKET=public-demo-quarantine-assets
CV_OBJECT_STORE_TASK_BUCKET=public-demo-task-assets
CV_OBJECT_STORE_FOUNDATION_BUCKET=public-demo-foundation-assets
CV_OBJECT_STORE_PROVIDER_RESULT_BUCKET=public-demo-provider-results
CV_OBJECT_STORE_FORCE_PATH_STYLE=false
CV_OBJECT_STORE_REQUIRE_ENCRYPTION=true
CV_OBJECT_STORE_TLS_VERIFY=true
CV_WEB_ALLOWED_WORKSPACE_IDS=catalog-demo
CV_WEB_ADMIN_WORKSPACE_IDS=
CV_WEB_PRINCIPAL_ACTOR_ID=public-demo-workbench
CV_TRUSTED_PRINCIPAL_CURRENT_KEY_ID=public-demo-phase3-current
CV_VISION_ADAPTER=deterministic
CV_EMBEDDING_ADAPTER=deterministic
CV_EMBEDDING_PROVIDER=fixture
CV_ASSET_CONTENT_SAFETY_ADAPTER=deterministic
CV_VALIDATION_DATA_TRANSFER_ENABLED=false
CV_VISION_DATA_TRANSFER_ENABLED=false
CV_EMBEDDING_DATA_TRANSFER_ENABLED=false
CV_CREATIVE_PLAN_CURSOR_MAX_AGE_SECONDS=900
CV_WORKFLOW_EVENT_CURSOR_MAX_AGE_SECONDS=900
CV_TOOL_INTENT_ALLOWED_COST_CLASSES=["low"]
CV_TOOL_INTENT_QUOTA_UNITS=8
