# Production Index Worker example:
# CV_EMBEDDING_ADAPTER=alibaba
# CV_EMBEDDING_PROVIDER=alibaba-model-studio
# CV_EMBEDDING_MODEL_FAMILY=qwen3-vl-embedding
# CV_EMBEDDING_MODEL_ID=qwen3-vl-embedding
# CV_EMBEDDING_PINNED_REVISION=commercevision-qwen3-vl-embedding-epoch-2026-07-31
# CV_EMBEDDING_DIMENSION=1024
# CV_ALIBABA_EMBEDDING_API_KEY_FILE=/run/secrets/alibaba-embedding-api-key
# CV_ALIBABA_EMBEDDING_ALLOWED_IMAGE_ORIGINS=["https://controlled-read.example.com"]
# CV_EMBEDDING_DATA_TRANSFER_ENABLED=true
# CV_EMBEDDING_DATA_TRANSFER_POLICY_VERSION=enterprise-embedding-transfer-v1
# CV_EMBEDDING_DATA_TRANSFER_ALLOWED_WORKSPACE_IDS=["Catalog-A"]
# CV_EMBEDDING_DATA_TRANSFER_ALLOWED_RETENTION_CLASSES=["TASK","FOUNDATION"]
# CV_EMBEDDING_DATA_TRANSFER_ALLOWED_PROVIDERS=["alibaba-model-studio"]
# CV_EMBEDDING_DATA_TRANSFER_ALLOWED_ENDPOINT_REGIONS=["cn-beijing"]
# CV_EMBEDDING_DATA_TRANSFER_ALLOWED_ENDPOINT_HOSTS=["dashscope.aliyuncs.com"]
CV_ASSET_PROVENANCE_ADAPTER=deterministic
CV_DETERMINISTIC_PROVENANCE_STATUS=NOT_PRESENT
CV_C2PA_TRUST_CONFIG_VERSION=c2pa-trust-v1
CV_C2PA_SUBPROCESS_MEMORY_LIMIT_BYTES=536870912
CV_C2PA_SUBPROCESS_FILE_DESCRIPTOR_LIMIT=64
# Production Asset Workers must use Alibaba + C2PA and obtain these values from Secret Manager:
# CV_ALIBABA_CONTENT_SAFETY_ACCESS_KEY_ID=<secret>
# CV_ALIBABA_CONTENT_SAFETY_ACCESS_KEY_SECRET=<secret>
# CV_ALIBABA_CONTENT_SAFETY_ALLOWED_URL_ORIGINS=["https://controlled-read.example.com"]
# CV_VALIDATION_DATA_TRANSFER_ENABLED=true
# CV_VALIDATION_DATA_TRANSFER_POLICY_VERSION=enterprise-security-validation-v1
# CV_VALIDATION_DATA_TRANSFER_ALLOWED_WORKSPACE_IDS=["Catalog-A"]
# CV_VALIDATION_DATA_TRANSFER_ALLOWED_ASSET_KINDS=["IMAGE"]
# CV_VALIDATION_DATA_TRANSFER_ALLOWED_RETENTION_CLASSES=["FOUNDATION"]
# CV_VALIDATION_DATA_TRANSFER_ALLOWED_PROVIDERS=["alibaba-green"]
# CV_VALIDATION_DATA_TRANSFER_ALLOWED_ENDPOINT_REGIONS=["cn-shanghai"]
# ProductBrief API and Worker processes must share every non-secret Vision identity/policy
# value. Only the Worker receives the mounted API-key path and controlled image origins.
# Production also requires encrypted provider-result storage.
# CV_VISION_ADAPTER=alibaba
# CV_ALIBABA_VISION_API_KEY_FILE=/run/secrets/alibaba-vision-api-key
# CV_ALIBABA_VISION_API_KEY_FILE_MAX_BYTES=4096
# Local/test only alternative, exclusive with CV_ALIBABA_VISION_API_KEY_FILE:
# CV_ALIBABA_VISION_API_KEY=<worker-secret>
# CV_ALIBABA_VISION_ALLOWED_IMAGE_ORIGINS=["https://controlled-read.example.com"]
# CV_VISION_DATA_TRANSFER_ENABLED=true
# CV_VISION_DATA_TRANSFER_POLICY_VERSION=enterprise-security-vision-v1
# CV_VISION_DATA_TRANSFER_ALLOWED_WORKSPACE_IDS=["Catalog-A"]
# CV_VISION_DATA_TRANSFER_ALLOWED_RETENTION_CLASSES=["TASK","FOUNDATION"]
# CV_VISION_DATA_TRANSFER_ALLOWED_PROVIDERS=["alibaba-model-studio"]
# CV_VISION_DATA_TRANSFER_ALLOWED_ENDPOINT_REGIONS=["cn-beijing"]
# CV_VISION_DATA_TRANSFER_ALLOWED_ENDPOINT_HOSTS=["dashscope.aliyuncs.com"]
# CV_OBJECT_STORE_REQUIRE_ENCRYPTION=true
# CV_C2PA_TRUST_ANCHORS_PEM=<secret-file>
# CV_C2PA_TRUST_EKU_POLICY=<secret-file-containing-approved-OIDs>
CV_CORS_ORIGINS=["http://localhost:13000"]
CV_MCP_TRANSPORT=streamable-http
CV_MCP_HOST=0.0.0.0
CV_MCP_PORT=8001
CV_MCP_TOOL_POLICY_VERSION=mcp-tool-policy-v1
CV_MCP_MAX_ARGUMENT_BYTES=65536
CV_MCP_MAX_OUTPUT_BYTES=262144
CV_SCHEDULER_HOST=0.0.0.0
CV_SCHEDULER_PORT=8002
CV_SCHEDULER_POLL_SECONDS=2
CV_SCHEDULER_BATCH_SIZE=50
CV_SCHEDULER_LEASE_SECONDS=30
CV_SCHEDULER_RECOVERY_INTERVAL_SECONDS=10
CV_SCHEDULER_OPERATION_RECOVERY_INTERVAL_SECONDS=10
CV_RIGHTS_EXPIRY_SCAN_INTERVAL_SECONDS=10
CV_SCHEDULER_SCANNER_TIMEOUT_SECONDS=30
CV_OPERATION_RETRY_INITIAL_SECONDS=1
CV_OPERATION_RETRY_MAX_SECONDS=300
CV_OPERATION_RETRY_MAX_ELAPSED_SECONDS=86400
CV_OPERATION_RECONCILIATION_INITIAL_SECONDS=2
CV_OPERATION_RECONCILIATION_MAX_SECONDS=3600
CV_OPERATION_RECONCILIATION_MAX_ELAPSED_SECONDS=345600
# Phase 2 trusted-gateway adapter. Configure current key id+secret atomically. During a rolling
# rotation, keep exactly one previous key id+secret; unknown key ids fail closed.
# CV_TRUSTED_PRINCIPAL_CURRENT_KEY_ID=gateway-2026-07
# CV_TRUSTED_PRINCIPAL_CURRENT_HMAC_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# CV_TRUSTED_PRINCIPAL_PREVIOUS_KEY_ID=gateway-2026-06
# CV_TRUSTED_PRINCIPAL_PREVIOUS_HMAC_SECRET=replace-with-the-previous-random-secret
CV_TRUSTED_PRINCIPAL_MAX_AGE_SECONDS=300
CV_TRUSTED_PRINCIPAL_FUTURE_SKEW_SECONDS=30
# Brand Profile cursors derive purpose-separated signing/scope keys from the
# trusted-principal key ring. Keep the previous root key for:
# max(principal TTL, cursor TTL) + max(principal skew, cursor skew) + rollout margin.
CV_BRAND_PROFILE_CURSOR_MAX_AGE_SECONDS=86400
CV_BRAND_PROFILE_CURSOR_FUTURE_SKEW_SECONDS=30
CV_WEB_ALLOWED_WORKSPACE_IDS=catalog-demo
CV_WEB_ADMIN_WORKSPACE_IDS=
CV_WEB_PRINCIPAL_ACTOR_ID=catalog-workbench
CV_API_PROXY_TIMEOUT_MS=15000
CV_WORKER_QUEUES=["commercevision.workflow","commercevision.asset","commercevision.index","commercevision.maintenance"]
CV_WORKER_REQUIRED_OPERATION_KINDS=["ASSET_VALIDATION","ASSET_DELETION","ASSET_INDEXING","PRODUCT_BRIEF_ANALYSIS"]
CV_WORKER_READINESS_PATH=/tmp/commercevision-worker-ready.json
# Must cover the full validated remote readiness cycle; see the ProductBrief runbook formula.
CV_WORKER_READINESS_MAX_AGE_SECONDS=50
CV_WORKFLOW_RETENTION_HOURS=72
CV_WORKFLOW_STEP_LEASE_SECONDS=300
CV_WORKFLOW_MESSAGE_MAX_ATTEMPTS=8
