CV_ENVIRONMENT=local
CV_LOG_LEVEL=INFO
CV_PYPI_INDEX_URL=https://pypi.org/simple
# CV_SECRETS_DIR=C:\path\to\runtime-secrets
CV_READINESS_PROBE_EXTERNAL=false
CV_MYSQL_DSN=mysql+aiomysql://commercevision:commercevision@mysql:3306/commercevision
CV_MYSQL_POOL_SIZE=10
CV_MYSQL_MAX_OVERFLOW=20
CV_MYSQL_POOL_RECYCLE_SECONDS=1800
CV_MYSQL_CONNECT_TIMEOUT_SECONDS=5
CV_REDIS_URL=redis://redis:6379/0
CV_RABBITMQ_URL=amqp://commercevision:commercevision@rabbitmq:5672//
CV_MILVUS_URI=http://milvus:19530
CV_MILVUS_HEALTH_URI=http://milvus:9091/healthz
CV_OBJECT_STORE_BACKEND=minio
CV_OBJECT_STORE_CREDENTIAL_MODE=static
CV_OBJECT_STORE_ENDPOINT=http://minio:9000
CV_OBJECT_STORE_PRESIGN_ENDPOINT=http://localhost:19000
CV_OBJECT_STORE_ACCESS_KEY=commercevision
CV_OBJECT_STORE_SECRET_KEY=commercevision-secret
# Production OSS must use one renewable identity mode. ECS mode uses IMDSv2 only:
# CV_OBJECT_STORE_CREDENTIAL_MODE=ecs_ram_role
# CV_OBJECT_STORE_RAM_ROLE_NAME=commercevision-assets
# ACK OIDC mode requires a read-only projected token file and an explicit STS endpoint:
# CV_OBJECT_STORE_CREDENTIAL_MODE=oidc_role_arn
# CV_OBJECT_STORE_OIDC_ROLE_ARN=acs:ram::1234567890123456:role/commercevision-assets
# CV_OBJECT_STORE_OIDC_PROVIDER_ARN=acs:ram::1234567890123456:oidc-provider/commercevision
# CV_OBJECT_STORE_OIDC_TOKEN_FILE_PATH=/var/run/secrets/aliyun/oidc-token
# CV_OBJECT_STORE_STS_ENDPOINT=sts-vpc.cn-hangzhou.aliyuncs.com
# CV_OBJECT_STORE_ROLE_SESSION_NAME=commercevision-object-storage
CV_OBJECT_STORE_QUARANTINE_BUCKET=quarantine-assets
CV_OBJECT_STORE_TASK_BUCKET=task-assets
CV_OBJECT_STORE_FOUNDATION_BUCKET=foundation-assets
CV_OBJECT_STORE_PROVIDER_RESULT_BUCKET=provider-results
CV_OBJECT_STORE_CORS_ORIGINS=http://localhost:13000
CV_OBJECT_STORE_FORCE_PATH_STYLE=true
CV_OBJECT_STORE_REQUIRE_ENCRYPTION=false
CV_OBJECT_STORE_CONNECT_TIMEOUT_SECONDS=3
CV_OBJECT_STORE_READ_TIMEOUT_SECONDS=30
CV_OBJECT_STORE_READINESS_TIMEOUT_SECONDS=1
CV_OBJECT_STORE_CREDENTIAL_REFRESH_TIMEOUT_SECONDS=5
CV_UPLOAD_SESSION_EXPIRY_SECONDS=900
CV_UPLOAD_CLEANUP_PRESIGN_GRACE_SECONDS=30
CV_UPLOAD_CLEANUP_MAX_ATTEMPTS=600
CV_UPLOAD_CLEANUP_RECONCILE_INTERVAL_SECONDS=3600
CV_UPLOAD_CLEANUP_RECONCILE_HORIZON_SECONDS=259200
CV_UPLOAD_CLEANUP_RECONCILE_MAX_ATTEMPTS=80
CV_UPLOAD_FINALIZE_LEASE_SECONDS=120
CV_ASSET_VALIDATION_MAX_ATTEMPTS=5
CV_CORS_ORIGINS=["http://localhost:13000"]
CV_MCP_TRANSPORT=streamable-http
CV_MCP_HOST=0.0.0.0
CV_MCP_PORT=8001
CV_SCHEDULER_HOST=0.0.0.0
CV_SCHEDULER_PORT=8002
CV_SCHEDULER_POLL_SECONDS=2
CV_SCHEDULER_BATCH_SIZE=50
CV_SCHEDULER_LEASE_SECONDS=30
CV_SCHEDULER_RECOVERY_INTERVAL_SECONDS=10
CV_SCHEDULER_OPERATION_RECOVERY_INTERVAL_SECONDS=10
CV_SCHEDULER_SCANNER_TIMEOUT_SECONDS=30
CV_OPERATION_RETRY_INITIAL_SECONDS=1
CV_OPERATION_RETRY_MAX_SECONDS=300
CV_OPERATION_RETRY_MAX_ELAPSED_SECONDS=86400
CV_OPERATION_RECONCILIATION_INITIAL_SECONDS=2
CV_OPERATION_RECONCILIATION_MAX_SECONDS=3600
CV_OPERATION_RECONCILIATION_MAX_ELAPSED_SECONDS=345600
# Phase 2 trusted-gateway adapter. Configure current key id+secret atomically. During a rolling
# rotation, keep exactly one previous key id+secret; unknown key ids fail closed.
# CV_TRUSTED_PRINCIPAL_CURRENT_KEY_ID=gateway-2026-07
# CV_TRUSTED_PRINCIPAL_CURRENT_HMAC_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# CV_TRUSTED_PRINCIPAL_PREVIOUS_KEY_ID=gateway-2026-06
# CV_TRUSTED_PRINCIPAL_PREVIOUS_HMAC_SECRET=replace-with-the-previous-random-secret
CV_TRUSTED_PRINCIPAL_MAX_AGE_SECONDS=300
CV_TRUSTED_PRINCIPAL_FUTURE_SKEW_SECONDS=30
CV_WEB_ALLOWED_WORKSPACE_IDS=catalog-demo
CV_WEB_PRINCIPAL_ACTOR_ID=catalog-workbench
CV_API_PROXY_TIMEOUT_MS=15000
CV_WORKER_REQUIRED_OPERATION_KINDS=[]
CV_WORKER_READINESS_PATH=/tmp/commercevision-worker-ready.json
CV_WORKFLOW_RETENTION_HOURS=72
CV_WORKFLOW_STEP_LEASE_SECONDS=300
CV_WORKFLOW_MESSAGE_MAX_ATTEMPTS=8
CV_WORKER_CONSUMER_NAME=agent-worker
CV_WORKER_CONCURRENCY=2
CV_BIND_HOST=127.0.0.1
CV_MYSQL_HOST_PORT=13316
CV_REDIS_HOST_PORT=16379
CV_RABBITMQ_HOST_PORT=15673
CV_RABBITMQ_MANAGEMENT_PORT=25672
CV_MINIO_API_HOST_PORT=19000
CV_MINIO_CONSOLE_HOST_PORT=19001
CV_MILVUS_HOST_PORT=19531
CV_MILVUS_HEALTH_HOST_PORT=19091
CV_OTEL_GRPC_HOST_PORT=14317
CV_OTEL_HTTP_HOST_PORT=14318
CV_OTEL_HEALTH_HOST_PORT=14319
CV_API_HOST_PORT=18000
CV_MCP_HOST_PORT=18001
CV_SCHEDULER_HOST_PORT=18002
CV_WEB_HOST_PORT=13000
